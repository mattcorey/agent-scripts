#!/bin/bash

# Git Worktree Status Script
# Provides detailed status for all worktrees: commits, merge state, remote state

set -e

# Function to display usage
usage() {
    echo "Usage: wt-status [options] [worktree-name]"
    echo ""
    echo "Shows detailed status for all worktrees (or a specific one)."
    echo ""
    echo "Options:"
    echo "  -h, --help               Show this help message"
    echo "  --staleness-days N       Days of inactivity before flagging as abandoned (default: 30)"
    echo ""
    echo "Output per worktree:"
    echo "  - Branch name and commit count ahead of base branch"
    echo "  - First and last commit dates"
    echo "  - Diff stat (files changed, insertions, deletions)"
    echo "  - Whether pushed to origin"
    echo "  - Whether merged into base branch"
    echo "  - Uncommitted changes warning"
    echo ""
    echo "Examples:"
    echo "  wt-status"
    echo "  wt-status calendar-2.0"
    exit 0
}

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: Not in a git repository"
    exit 1
fi

# Parse arguments
FILTER_NAME=""
STALENESS_DAYS=30
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            ;;
        --staleness-days)
            if [[ -z "${2:-}" || "$2" == -* ]]; then
                echo "Error: --staleness-days requires a numeric argument"
                exit 1
            fi
            STALENESS_DAYS="$2"
            shift 2
            ;;
        -*)
            echo "Unknown option: $1"
            usage
            ;;
        *)
            FILTER_NAME="$1"
            shift
            ;;
    esac
done

# Ensure we're on the main worktree so base ref is available
MAIN_WORKTREE=$(git worktree list --porcelain | head -1 | sed 's/^worktree //')

# Detect the default branch (main, master, trunk, etc.)
BASE_BRANCH=""
if REF=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null); then
    BASE_BRANCH=${REF#refs/remotes/origin/}
fi
# Fallback: check common names if origin/HEAD isn't set
if [[ -z "$BASE_BRANCH" ]]; then
    for CANDIDATE in main master trunk; do
        if git rev-parse --verify "$CANDIDATE" >/dev/null 2>&1; then
            BASE_BRANCH="$CANDIDATE"
            break
        fi
    done
fi
if [[ -z "$BASE_BRANCH" ]]; then
    echo "Error: Could not detect default branch (tried origin/HEAD, main, master, trunk)"
    exit 1
fi

PROJECT_NAME=$(basename "$MAIN_WORKTREE")
echo "🌿 Worktree Status for ${PROJECT_NAME}"
echo "=================================="

# Fetch latest remote state so merge/push checks are accurate
echo "   Fetching latest from origin..."
git fetch --prune origin >/dev/null 2>&1 || echo "   ⚠️  Could not fetch from origin (offline?)"
REMOTE_BASE="origin/${BASE_BRANCH}"
echo ""

# Compute last activity epoch for a worktree (max of last commit date and newest dirty file mtime)
compute_last_activity_epoch() {
    local wt_path="$1"
    local remote_base="$2"
    local max_epoch=0

    # Last commit date (unix epoch) — check branch-specific commits first, fall back to HEAD
    local commit_epoch
    commit_epoch=$(git -C "$wt_path" log -1 --format="%ct" "${remote_base}..HEAD" 2>/dev/null || echo "0")
    if [[ -z "$commit_epoch" || "$commit_epoch" == "0" ]]; then
        # No branch-specific commits; use HEAD's commit time (e.g., sitting on main)
        commit_epoch=$(git -C "$wt_path" log -1 --format="%ct" HEAD 2>/dev/null || echo "0")
    fi
    if [[ "$commit_epoch" -gt "$max_epoch" ]]; then
        max_epoch=$commit_epoch
    fi

    # Newest uncommitted file mtime (unix epoch)
    while IFS= read -r -d '' entry; do
        # porcelain -z format: XY<space>filename<NUL> — strip the 3-char prefix
        local file="${entry:3}"
        if [[ -f "$wt_path/$file" ]]; then
            local mtime
            mtime=$(stat -f "%m" "$wt_path/$file" 2>/dev/null || echo "0")
            if [[ "$mtime" -gt "$max_epoch" ]]; then
                max_epoch=$mtime
            fi
        fi
    done < <(git -C "$wt_path" status --porcelain -z 2>/dev/null)

    echo "$max_epoch"
}

# Collect worktree paths and branches
WORKTREES=()
BRANCHES=()

while IFS= read -r line; do
    if [[ $line == worktree* ]]; then
        WT_PATH=${line#worktree }
        read -r HEAD_LINE || true
        read -r BRANCH_LINE || true

        # Skip the main worktree
        if [[ "$WT_PATH" == "$MAIN_WORKTREE" ]]; then
            continue
        fi

        WT_NAME=$(basename "$WT_PATH")

        # If filtering, skip non-matching worktrees
        if [[ -n "$FILTER_NAME" && "$WT_NAME" != "$FILTER_NAME" ]]; then
            continue
        fi

        BRANCH_NAME=${BRANCH_LINE#branch refs/heads/}
        WORKTREES+=("$WT_PATH")
        BRANCHES+=("$BRANCH_NAME")
    fi
done < <(git worktree list --porcelain)

if [[ ${#WORKTREES[@]} -eq 0 ]]; then
    if [[ -n "$FILTER_NAME" ]]; then
        echo "No worktree found matching '${FILTER_NAME}'"
    else
        echo "No worktrees found (besides main)."
    fi
    exit 0
fi

REMOVAL_CANDIDATES=()
ABANDONED_CANDIDATES=()
ABANDONED_DAYS_AGO=()
IN_PROGRESS=()
IN_PROGRESS_DAYS_AGO=()

NOW_EPOCH=$(date +%s)
STALENESS_SECONDS=$((STALENESS_DAYS * 86400))

for i in "${!WORKTREES[@]}"; do
    WT_PATH="${WORKTREES[$i]}"
    BRANCH="${BRANCHES[$i]}"
    WT_NAME=$(basename "$WT_PATH")

    echo "📁 ${WT_NAME}"
    echo "   🌿 Branch: ${BRANCH}"
    echo "   📍 Path: ${WT_PATH}"

    # --- Determine state up front ---
    WT_HEAD=$(git -C "$WT_PATH" rev-parse HEAD 2>/dev/null)
    REMOTE_BASE_HEAD=$(git rev-parse "$REMOTE_BASE" 2>/dev/null || true)

    # Uncommitted changes
    DIRTY_COUNT=$(git -C "$WT_PATH" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    IS_DIRTY=false
    if [[ "$DIRTY_COUNT" -gt 0 ]]; then
        IS_DIRTY=true
    fi

    # Is HEAD an ancestor of origin/main? (i.e. all commits have been merged)
    IS_MERGED=false
    if [[ -n "$REMOTE_BASE_HEAD" ]] && git merge-base --is-ancestor "$WT_HEAD" "$REMOTE_BASE" 2>/dev/null; then
        IS_MERGED=true
    fi

    # Was this branch ever a real feature branch that got merged?
    # Check if origin/main has a merge commit whose subject ends with this
    # exact branch name (after "/"). Using grep with end-of-line anchor
    # prevents partial matches (e.g., "feature-1" matching "feature-123").
    WAS_MERGED_BRANCH=false
    if [[ "$IS_MERGED" == true ]]; then
        MERGE_COMMIT=$(git log --merges --format="%s" "$REMOTE_BASE" 2>/dev/null | grep "/${BRANCH}$" | head -1)
        if [[ -n "$MERGE_COMMIT" ]]; then
            WAS_MERGED_BRANCH=true
        fi
    fi

    # Does the branch still exist on the remote?
    REMOTE_REF=$(git ls-remote --heads origin "$BRANCH" 2>/dev/null | head -1)

    # --- Commits ---
    UNMERGED_COUNT=$(git -C "$WT_PATH" rev-list --count "${REMOTE_BASE}..HEAD" 2>/dev/null || echo "0")

    if [[ "$IS_MERGED" == true && "$UNMERGED_COUNT" -eq 0 && "$WAS_MERGED_BRANCH" == false ]]; then
        # HEAD is on main, no unmerged commits, no merge commit found — never had unique work
        echo "   📊 Commits ahead of ${BASE_BRANCH}: 0"
        echo "   📝 No unique commits (branch tip is on ${BASE_BRANCH})"
    elif [[ "$IS_MERGED" == true && "$UNMERGED_COUNT" -eq 0 ]]; then
        # All commits have been merged into main — show what was contributed
        # Use the reflog or branch history to find original commits
        # Count how many commits on this branch are reachable from HEAD but not
        # from where the branch originally diverged from main
        LAST_COMMIT=$(git -C "$WT_PATH" log -1 --format="%ai | %s" 2>/dev/null)
        echo "   📊 All commits merged into ${BASE_BRANCH}"
        echo "   🕐 Last commit:  ${LAST_COMMIT}"
    else
        # Unmerged branch with unique commits
        echo "   📊 Commits ahead of ${BASE_BRANCH}: ${UNMERGED_COUNT}"
        if [[ "$UNMERGED_COUNT" -gt 0 ]]; then
            FIRST_COMMIT=$(git -C "$WT_PATH" log "${REMOTE_BASE}..HEAD" --reverse --format="%ai | %s" 2>/dev/null | head -1)
            LAST_COMMIT=$(git -C "$WT_PATH" log "${REMOTE_BASE}..HEAD" --format="%ai | %s" 2>/dev/null | head -1)
            echo "   🕐 First commit: ${FIRST_COMMIT}"
            echo "   🕐 Last commit:  ${LAST_COMMIT}"

            DIFF_STAT=$(git -C "$WT_PATH" diff --shortstat "${REMOTE_BASE}..HEAD" 2>/dev/null || echo "")
            if [[ -n "$DIFF_STAT" ]]; then
                echo "   📝 Changes:${DIFF_STAT}"
            fi
        fi
    fi

    # --- Uncommitted changes ---
    if [[ "$IS_DIRTY" == true ]]; then
        echo "   ⚠️  Uncommitted changes: ${DIRTY_COUNT} file(s)"
    fi

    # --- Pushed to origin ---
    if [[ -n "$REMOTE_REF" ]]; then
        echo "   ☁️  Pushed to origin: Yes"
    elif [[ "$WAS_MERGED_BRANCH" == true ]]; then
        echo "   ☁️  Pushed to origin: Yes (branch deleted after merge)"
    else
        echo "   ☁️  Pushed to origin: No"
    fi

    # --- Merged / removal candidate ---
    if [[ "$IS_MERGED" == true ]]; then
        if [[ "$WAS_MERGED_BRANCH" == true ]]; then
            # Had real commits, all now merged
            if [[ "$IS_DIRTY" == true ]]; then
                echo "   ✅ Merged into ${BASE_BRANCH}"
                echo "   🚧 NOT a removal candidate — has ${DIRTY_COUNT} uncommitted file(s)"
            else
                echo "   ✅ Merged into ${BASE_BRANCH} — candidate for removal"
                REMOVAL_CANDIDATES+=("$WT_NAME")
            fi
        else
            # Never had unique work — just a checkout of main
            if [[ "$IS_DIRTY" == true ]]; then
                echo "   🚧 Has uncommitted work — review before removing"
            else
                echo "   🗑️  No commits, no changes — candidate for removal"
                REMOVAL_CANDIDATES+=("$WT_NAME")
            fi
        fi
    else
        # Check squash/rebase merge (diff is empty even though commits differ)
        # Skip this check if the remote base ref is missing to avoid false positives
        if [[ -n "$REMOTE_BASE_HEAD" ]]; then
            DIFF_TO_MAIN=$(git -C "$WT_PATH" diff "${REMOTE_BASE}..HEAD" --stat 2>/dev/null | tail -1)
        else
            DIFF_TO_MAIN="unknown"
        fi
        if [[ -z "$DIFF_TO_MAIN" ]]; then
            if [[ "$IS_DIRTY" == true ]]; then
                echo "   ✅ Merged into ${BASE_BRANCH} (squash/rebase)"
                echo "   🚧 NOT a removal candidate — has ${DIRTY_COUNT} uncommitted file(s)"
            else
                echo "   ✅ Merged into ${BASE_BRANCH} (squash/rebase) — candidate for removal"
                REMOVAL_CANDIDATES+=("$WT_NAME")
            fi
        else
            echo "   ❌ Merged into ${BASE_BRANCH}: No"
        fi
    fi

    # --- Last activity & category ---
    LAST_ACTIVITY_EPOCH=$(compute_last_activity_epoch "$WT_PATH" "$REMOTE_BASE")
    if [[ "$LAST_ACTIVITY_EPOCH" -gt 0 ]]; then
        LAST_ACTIVITY_DATE=$(date -r "$LAST_ACTIVITY_EPOCH" "+%Y-%m-%d")
        DAYS_AGO=$(( (NOW_EPOCH - LAST_ACTIVITY_EPOCH) / 86400 ))
        if [[ "$DAYS_AGO" -eq 1 ]]; then
            DAYS_LABEL="1 day ago"
        else
            DAYS_LABEL="${DAYS_AGO} days ago"
        fi
        echo "   🕰️  Last activity: ${LAST_ACTIVITY_DATE} (${DAYS_LABEL})"
    else
        DAYS_AGO=0
        DAYS_LABEL="unknown"
    fi

    # Assign category (removal candidates already handled above)
    IS_REMOVAL=false
    for rc in "${REMOVAL_CANDIDATES[@]}"; do
        if [[ "$rc" == "$WT_NAME" ]]; then
            IS_REMOVAL=true
            break
        fi
    done

    if [[ "$IS_REMOVAL" == false ]]; then
        if [[ "$LAST_ACTIVITY_EPOCH" -gt 0 && $((NOW_EPOCH - LAST_ACTIVITY_EPOCH)) -gt $STALENESS_SECONDS ]]; then
            echo "   💤 Status: Possible abandoned work"
            ABANDONED_CANDIDATES+=("$WT_NAME")
            ABANDONED_DAYS_AGO+=("$DAYS_AGO")
        else
            echo "   🔧 Status: In progress"
            IN_PROGRESS+=("$WT_NAME")
            IN_PROGRESS_DAYS_AGO+=("$DAYS_AGO")
        fi
    fi

    echo ""
done

# --- Summary ---
echo "=================================="

HAS_OUTPUT=false

if [[ ${#REMOVAL_CANDIDATES[@]} -gt 0 ]]; then
    HAS_OUTPUT=true
    echo "🗑️  Removal candidates (merged, safe to remove):"
    for NAME in "${REMOVAL_CANDIDATES[@]}"; do
        echo "   - ${NAME}  →  wt-remove ${NAME} -y"
    done
    echo ""
fi

if [[ ${#ABANDONED_CANDIDATES[@]} -gt 0 ]]; then
    HAS_OUTPUT=true
    echo "💤 Possible abandoned work (no activity in ${STALENESS_DAYS}+ days):"
    for j in "${!ABANDONED_CANDIDATES[@]}"; do
        echo "   - ${ABANDONED_CANDIDATES[$j]} (${ABANDONED_DAYS_AGO[$j]} days)"
    done
    echo ""
fi

if [[ ${#IN_PROGRESS[@]} -gt 0 ]]; then
    HAS_OUTPUT=true
    echo "🔧 In progress:"
    for j in "${!IN_PROGRESS[@]}"; do
        echo "   - ${IN_PROGRESS[$j]} (${IN_PROGRESS_DAYS_AGO[$j]} days)"
    done
    echo ""
fi

if [[ "$HAS_OUTPUT" == false ]]; then
    echo "✨ No worktrees found."
fi
