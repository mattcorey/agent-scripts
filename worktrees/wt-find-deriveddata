#!/bin/bash

# Git Worktree DerivedData Finder Script
# Finds the DerivedData path for a git worktree containing an Xcode project
#
# Scans ~/Library/Developer/Xcode/DerivedData/ directly instead of invoking
# xcodebuild, which avoids slow build-graph resolution and fragile simulator
# destination matching.

set -e

DERIVED_DATA_ROOT="${HOME}/Library/Developer/Xcode/DerivedData"

# Function to display usage
usage() {
    echo "Usage: wt-find-deriveddata <worktree-name> [options]"
    echo ""
    echo "Finds the DerivedData path for a git worktree containing an Xcode project."
    echo ""
    echo "Arguments:"
    echo "  worktree-name   Name of the worktree directory to analyze"
    echo ""
    echo "Options:"
    echo "  --current       Use current directory instead of worktree name"
    echo "  --verbose       Show detailed information during detection"
    echo "  -h, --help      Show this help message"
    echo ""
    echo "Examples:"
    echo "  wt-find-deriveddata MyProject-ui-tweaks"
    echo "  wt-find-deriveddata --current"
    echo "  wt-find-deriveddata MyProject-feature --verbose"
    echo ""
    echo "Output:"
    echo "  Prints the DerivedData path to stdout on success"
    echo "  Prints errors to stderr and exits with non-zero code on failure"
    exit 1
}

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: Not in a git repository" >&2
    exit 1
fi

# Parse arguments
WORKTREE_NAME=""
USE_CURRENT=false
VERBOSE=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --current)
            USE_CURRENT=true
            shift
            ;;
        --verbose)
            VERBOSE=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage
            ;;
        *)
            if [ -z "$WORKTREE_NAME" ]; then
                WORKTREE_NAME="$1"
            else
                echo "Error: Too many arguments" >&2
                usage
            fi
            shift
            ;;
    esac
done

# Determine the target path
if [ "$USE_CURRENT" = true ]; then
    TARGET_PATH=$(pwd)
    if [ "$VERBOSE" = true ]; then
        echo "Using current directory: $TARGET_PATH" >&2
    fi
else
    # Check if worktree name is provided
    if [ -z "$WORKTREE_NAME" ]; then
        echo "Error: Worktree name is required (or use --current)" >&2
        usage
    fi

    # Find the actual worktree path by matching the name
    ACTUAL_WORKTREE_PATH=$(git worktree list | grep -E "/${WORKTREE_NAME}\s+" | awk '{print $1}' | head -1)

    if [ -z "$ACTUAL_WORKTREE_PATH" ]; then
        echo "Error: Worktree '${WORKTREE_NAME}' not found" >&2
        echo "" >&2
        echo "Available worktrees:" >&2
        git worktree list | while read -r path branch commit; do
            name=$(basename "$path")
            echo "  - $name" >&2
        done
        exit 1
    fi

    TARGET_PATH="$ACTUAL_WORKTREE_PATH"
    if [ "$VERBOSE" = true ]; then
        echo "Found worktree: $TARGET_PATH" >&2
    fi
fi

# Verify target path exists
if [ ! -d "$TARGET_PATH" ]; then
    echo "Error: Target path does not exist: $TARGET_PATH" >&2
    exit 1
fi

# Auto-detect project file to determine the project name
# Prefer .xcworkspace over .xcodeproj over Package.swift
PROJECT_FILE=""
PROJECT_TYPE=""

if [ "$VERBOSE" = true ]; then
    echo "Searching for Xcode project files in: $TARGET_PATH" >&2
fi

# Check for workspace files first
WORKSPACE_FILES=$(find "$TARGET_PATH" -maxdepth 1 -name "*.xcworkspace" -type d 2>/dev/null)
if [ -n "$WORKSPACE_FILES" ]; then
    PROJECT_FILE=$(echo "$WORKSPACE_FILES" | head -1)
    PROJECT_TYPE="workspace"
    if [ "$VERBOSE" = true ]; then
        echo "Found workspace: $(basename "$PROJECT_FILE")" >&2
    fi
else
    # Check for project files
    PROJECT_FILES=$(find "$TARGET_PATH" -maxdepth 1 -name "*.xcodeproj" -type d 2>/dev/null)
    if [ -n "$PROJECT_FILES" ]; then
        PROJECT_FILE=$(echo "$PROJECT_FILES" | head -1)
        PROJECT_TYPE="project"
        if [ "$VERBOSE" = true ]; then
            echo "Found project: $(basename "$PROJECT_FILE")" >&2
        fi
    elif [ -f "$TARGET_PATH/Package.swift" ]; then
        PROJECT_FILE="$TARGET_PATH/Package.swift"
        PROJECT_TYPE="package"
        if [ "$VERBOSE" = true ]; then
            echo "Found Swift Package: Package.swift" >&2
        fi
    else
        # No Xcode project found — nothing to clean up (not an error)
        if [ "$VERBOSE" = true ]; then
            echo "No Xcode project found in: $TARGET_PATH" >&2
        fi
        exit 0
    fi
fi

# Extract project name from file
if [ "$PROJECT_TYPE" = "package" ]; then
    PROJECT_NAME=$(grep -E '^\s*name:' "$PROJECT_FILE" | head -1 | sed -E 's/.*name:\s*"([^"]+)".*/\1/')
    if [ -z "$PROJECT_NAME" ]; then
        PROJECT_NAME=$(basename "$TARGET_PATH")
    fi
else
    PROJECT_NAME=$(basename "$PROJECT_FILE" | sed -E 's/\.(xcworkspace|xcodeproj)$//')
fi

if [ "$VERBOSE" = true ]; then
    echo "Project name: $PROJECT_NAME" >&2
fi

# Check that DerivedData root exists
if [ ! -d "$DERIVED_DATA_ROOT" ]; then
    if [ "$VERBOSE" = true ]; then
        echo "DerivedData root does not exist: $DERIVED_DATA_ROOT" >&2
    fi
    exit 0
fi

# Scan DerivedData for matching directories.
# Xcode names them <ProjectName>-<hash>, so we glob for the prefix.
# Then verify via the info.plist WorkspacePath to confirm it belongs to
# the right worktree (not the main checkout or another worktree).
MATCHED_PATH=""

for CANDIDATE in "$DERIVED_DATA_ROOT/${PROJECT_NAME}-"*/; do
    # Guard against no-match (the literal glob string)
    [ -d "$CANDIDATE" ] || continue

    if [ "$VERBOSE" = true ]; then
        echo "Checking candidate: $CANDIDATE" >&2
    fi

    # Each DerivedData folder has an info.plist with the WorkspacePath
    INFO_PLIST="${CANDIDATE}info.plist"
    if [ ! -f "$INFO_PLIST" ]; then
        if [ "$VERBOSE" = true ]; then
            echo "  Skipping (no info.plist)" >&2
        fi
        continue
    fi

    # Read WorkspacePath from the plist
    WORKSPACE_PATH=$(/usr/libexec/PlistBuddy -c "Print :WorkspacePath" "$INFO_PLIST" 2>/dev/null || true)
    if [ -z "$WORKSPACE_PATH" ]; then
        if [ "$VERBOSE" = true ]; then
            echo "  Skipping (no WorkspacePath in plist)" >&2
        fi
        continue
    fi

    if [ "$VERBOSE" = true ]; then
        echo "  WorkspacePath: $WORKSPACE_PATH" >&2
    fi

    # Check if the WorkspacePath points into our target worktree
    # The plist stores the path to the .xcodeproj/.xcworkspace/Package.swift
    case "$WORKSPACE_PATH" in
        "$TARGET_PATH"/*|"$TARGET_PATH")
            # Verify it has a Build folder (sanity check)
            if [ -d "${CANDIDATE}Build" ]; then
                # Remove trailing slash for clean output
                MATCHED_PATH="${CANDIDATE%/}"
                if [ "$VERBOSE" = true ]; then
                    echo "  ✓ Matched!" >&2
                fi
                break
            else
                if [ "$VERBOSE" = true ]; then
                    echo "  Skipping (no Build folder)" >&2
                fi
            fi
            ;;
        *)
            if [ "$VERBOSE" = true ]; then
                echo "  Skipping (WorkspacePath doesn't match target)" >&2
            fi
            ;;
    esac
done

if [ -z "$MATCHED_PATH" ]; then
    if [ "$VERBOSE" = true ]; then
        echo "No matching DerivedData found for project '$PROJECT_NAME' at path '$TARGET_PATH'" >&2
    fi
    # Exit successfully with no output — caller interprets empty output as "nothing to clean"
    exit 0
fi

# Output the DerivedData path to stdout
echo "$MATCHED_PATH"
