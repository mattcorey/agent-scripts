#!/bin/bash

# xc-ci - Local CI pipeline replicating Xcode Cloud
# Pipeline: Test → Build-check → Archive+upload for the selected Apple platforms

set -e

# ─── Defaults ────────────────────────────────────────────────────────────────

REPO_URL=""
BRANCH="main"
SCHEME=""
SKIP_TESTS=false
IOS_ONLY=false
VISIONOS_ONLY=false
MACOS_ONLY=false
KEEP_WORKSPACE=false
VERBOSE=false
APP_ID=""
TEAM_ID=""
XCODE_DIR=""
XCODE_DIR_PROVIDED=false
XCODE_DEVELOPER_DIR=""
XCODE_VERSION_OUTPUT=""

# ─── Colors ──────────────────────────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ─── State tracking ─────────────────────────────────────────────────────────

STEP_RESULTS=()
WORK_DIR=""
IOS_TEST_SIMULATOR_ID=""
IOS_SIMULATOR_NAME=""
IOS_RUNTIME_ID=""
IOS_SIMULATOR_CREATE_PID=""
IOS_SIMULATOR_CREATE_OUTPUT=""
IOS_SIMULATOR_CREATE_ERROR=""
PIPELINE_START=$SECONDS

# ─── Helpers ─────────────────────────────────────────────────────────────────

show_help() {
    cat << 'EOF'
xc-ci - Local iOS, visionOS, and macOS App Store/TestFlight pipeline

Clones a repo into an isolated temp workspace and runs a full CI pipeline:
test, build-check, archive, and upload to App Store Connect.

Pipeline:
  1. Clone repo into isolated temp workspace
  2. Resolve SPM dependencies
  3. Test iOS (builds + runs tests)
  4. Build-check visionOS (compilation validation)
  5. Archive + upload iOS to App Store Connect
  6. Archive + upload visionOS to App Store Connect
  7. With --macos-only: test, archive, export a PKG, and upload macOS

Builds are uploaded directly to ASC for App Store Connect/TestFlight.
iOS and visionOS share a build number; macOS uses the next build number
for the selected scheme's MARKETING_VERSION and MAC_OS platform.

Usage: xc-ci --repo <url> --app-id <id> [OPTIONS]

Required:
  --repo <url>         Git repo SSH URL
  --app-id <id>        App Store Connect app ID (numeric)

Options:
  --branch <branch>    Branch to build [default: main]
  --scheme <scheme>    Xcode scheme [default: auto-detect]
  --xcode-dir <path>   Xcode.app path to use without changing xcode-select
  --team-id <id>       Development team ID (required with --macos-only)
  --skip-tests         Skip the platform test phase
  --ios-only           Only test + archive for iOS (skip visionOS)
  --visionos-only      Only build-check + archive for visionOS (skip iOS)
  --macos-only         Test, archive, export, and upload macOS only
  --keep-workspace     Don't clean up temp directory on exit
  --verbose            Show full xcodebuild output
  -h, --help           Show this help message

Authentication:
  Build number lookup and uploads use the asc CLI. Run `asc auth doctor`
  before this script to verify App Store Connect authentication.

Examples:
  xc-ci --repo git@github.com:user/App.git --app-id 123456789
  xc-ci --repo git@github.com:user/App.git --app-id 123456789 --ios-only
  xc-ci --repo git@github.com:user/App.git --app-id 123456789 --skip-tests
  xc-ci --repo git@github.com:user/App.git --app-id 123456789 --xcode-dir /Applications/Xcode.app
  xc-ci --repo git@github.com:user/MacApp.git --app-id 123456789 --scheme MacApp --team-id ABC1234567 --macos-only
  xc-ci --repo git@github.com:user/App.git --app-id 123456789 --keep-workspace

EOF
}

log_step() {
    echo ""
    echo -e "${BLUE}${BOLD}━━━ $1 ━━━${NC}"
    echo ""
}

log_ok() {
    echo -e "${GREEN}✓ $1${NC}"
}

log_fail() {
    echo -e "${RED}✗ $1${NC}"
}

log_warn() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

log_info() {
    echo -e "${DIM}  $1${NC}"
}

format_duration() {
    local secs=$1
    if [ "$secs" -ge 60 ]; then
        printf "%dm %ds" $((secs / 60)) $((secs % 60))
    else
        printf "%ds" "$secs"
    fi
}

STEP_START=$SECONDS

step_timer_start() {
    STEP_START=$SECONDS
}

record_step() {
    local name="$1"
    local status="$2"  # PASS, FAIL, or SKIP
    local elapsed=$((SECONDS - STEP_START))
    STEP_RESULTS+=("$status|$name|$elapsed")
}

print_summary() {
    local total_elapsed=$((SECONDS - PIPELINE_START))
    echo ""
    echo -e "${BOLD}━━━ PIPELINE SUMMARY ━━━${NC}"
    echo ""
    for entry in "${STEP_RESULTS[@]}"; do
        local status="${entry%%|*}"
        local rest="${entry#*|}"
        local name="${rest%%|*}"
        local elapsed="${rest#*|}"
        local duration
        duration=$(format_duration "$elapsed")
        if [ "$status" = "PASS" ]; then
            echo -e "  ${GREEN}✓${NC} $name ${DIM}($duration)${NC}"
        elif [ "$status" = "SKIP" ]; then
            echo -e "  ${DIM}– $name (skipped)${NC}"
        else
            echo -e "  ${RED}✗${NC} $name ${DIM}($duration)${NC}"
        fi
    done
    echo ""
    echo -e "  ${BOLD}Total: $(format_duration "$total_elapsed")${NC}"
    echo ""
}

cleanup_ios_test_simulator() {
    if [ -n "$IOS_SIMULATOR_CREATE_PID" ]; then
        wait "$IOS_SIMULATOR_CREATE_PID" 2>/dev/null || true
        IOS_SIMULATOR_CREATE_PID=""
    fi

    if [ -z "$IOS_TEST_SIMULATOR_ID" ] && [ -n "$IOS_SIMULATOR_CREATE_OUTPUT" ] && [ -f "$IOS_SIMULATOR_CREATE_OUTPUT" ]; then
        local created_simulator_id
        created_simulator_id=$(tr -d '[:space:]' < "$IOS_SIMULATOR_CREATE_OUTPUT")
        if [[ "$created_simulator_id" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]]; then
            IOS_TEST_SIMULATOR_ID="$created_simulator_id"
        fi
    fi

    if [ -n "$IOS_SIMULATOR_CREATE_OUTPUT" ]; then
        rm -f "$IOS_SIMULATOR_CREATE_OUTPUT"
        IOS_SIMULATOR_CREATE_OUTPUT=""
    fi
    if [ -n "$IOS_SIMULATOR_CREATE_ERROR" ]; then
        rm -f "$IOS_SIMULATOR_CREATE_ERROR"
        IOS_SIMULATOR_CREATE_ERROR=""
    fi

    if [ -z "$IOS_TEST_SIMULATOR_ID" ] && [ -n "$IOS_SIMULATOR_NAME" ] && [ -n "$IOS_RUNTIME_ID" ]; then
        local discovered_simulator_id
        discovered_simulator_id=$(run_xcode_tool xcrun simctl list devices -j 2>/dev/null \
            | jq -r --arg runtime "$IOS_RUNTIME_ID" --arg name "$IOS_SIMULATOR_NAME" '
                [.devices[$runtime][]? | select(.name == $name)]
                | if length == 1 then .[0].udid else empty end
            ' 2>/dev/null || true)
        if [[ "$discovered_simulator_id" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]]; then
            IOS_TEST_SIMULATOR_ID="$discovered_simulator_id"
        fi
    fi

    if [ -z "$IOS_TEST_SIMULATOR_ID" ]; then
        return 0
    fi

    local simulator_id="$IOS_TEST_SIMULATOR_ID"

    log_info "Deleting temporary iOS simulator ($simulator_id)..."
    run_xcode_tool xcrun simctl shutdown "$simulator_id" >/dev/null 2>&1 || true
    if run_xcode_tool xcrun simctl delete "$simulator_id" >/dev/null 2>&1; then
        IOS_TEST_SIMULATOR_ID=""
    else
        log_warn "Could not delete temporary iOS simulator: $simulator_id"
        return 1
    fi
}

cleanup() {
    local exit_status=$?
    local simulator_cleanup_failed=false
    if ! cleanup_ios_test_simulator; then
        simulator_cleanup_failed=true
    fi
    if [ -n "$WORK_DIR" ] && [ -d "$WORK_DIR" ]; then
        if [ "$exit_status" -ne 0 ]; then
            log_warn "Pipeline failed; preserving workspace: $WORK_DIR"
        elif [ "$KEEP_WORKSPACE" = true ]; then
            log_warn "Keeping workspace: $WORK_DIR"
        else
            log_info "Cleaning up workspace..."
            rm -rf "$WORK_DIR"
        fi
    fi
    if [ "$exit_status" -eq 0 ] && [ "$simulator_cleanup_failed" = true ]; then
        log_fail "Pipeline completed, but temporary iOS simulator cleanup failed"
        trap - EXIT
        exit 1
    fi
    return "$exit_status"
}

run_xcode_tool() {
    if [ -n "$XCODE_DEVELOPER_DIR" ]; then
        local tool="$1"
        shift
        if [ -x "$XCODE_DEVELOPER_DIR/usr/bin/$tool" ]; then
            DEVELOPER_DIR="$XCODE_DEVELOPER_DIR" "$XCODE_DEVELOPER_DIR/usr/bin/$tool" "$@"
        else
            DEVELOPER_DIR="$XCODE_DEVELOPER_DIR" "$tool" "$@"
        fi
    else
        "$@"
    fi
}

validate_xcode_dir() {
    if [ "$XCODE_DIR_PROVIDED" = false ]; then
        return 0
    fi

    if [ -z "$XCODE_DIR" ]; then
        log_fail "--xcode-dir requires a non-empty Xcode.app path"
        return 1
    fi

    local normalized_xcode_dir="${XCODE_DIR%/}"
    local absolute_xcode_dir
    case "$normalized_xcode_dir" in
        /*) absolute_xcode_dir="$normalized_xcode_dir" ;;
        *)
            local xcode_parent
            local xcode_name
            local absolute_parent
            xcode_parent=$(dirname "$normalized_xcode_dir")
            xcode_name=$(basename "$normalized_xcode_dir")
            if ! absolute_parent=$(cd "$xcode_parent" 2>/dev/null && pwd -P); then
                log_fail "Invalid --xcode-dir: parent directory does not exist: $xcode_parent"
                return 1
            fi
            absolute_xcode_dir="$absolute_parent/$xcode_name"
            ;;
    esac

    XCODE_DEVELOPER_DIR="$absolute_xcode_dir/Contents/Developer"
    local xcodebuild_path="$XCODE_DEVELOPER_DIR/usr/bin/xcodebuild"

    if [ ! -x "$xcodebuild_path" ]; then
        log_fail "Invalid --xcode-dir: expected executable xcodebuild at $xcodebuild_path"
        return 1
    fi

    set +e
    XCODE_VERSION_OUTPUT=$(DEVELOPER_DIR="$XCODE_DEVELOPER_DIR" "$xcodebuild_path" -version 2>&1)
    local result=$?
    set -e

    if [ $result -ne 0 ]; then
        log_fail "Invalid --xcode-dir: xcodebuild -version failed for $XCODE_DEVELOPER_DIR"
        echo "$XCODE_VERSION_OUTPUT" | head -10 | while IFS= read -r line; do
            [ -z "$line" ] && continue
            echo -e "  ${RED}✗${NC} $line"
        done
        return $result
    fi

    return 0
}

log_xcode_selection() {
    if [ -z "$XCODE_DEVELOPER_DIR" ]; then
        return 0
    fi

    local version_line
    local build_line
    version_line=$(echo "$XCODE_VERSION_OUTPUT" | sed -n '1p')
    build_line=$(echo "$XCODE_VERSION_OUTPUT" | sed -n '2p')

    log_info "Using Xcode: $version_line${build_line:+ ($build_line)}"
    log_info "Developer dir: $XCODE_DEVELOPER_DIR"
}

run_xcodebuild() {
    local label="$1"
    shift
    local temp_output
    temp_output=$(mktemp)

    if [ "$VERBOSE" = true ]; then
        set +e
        run_xcode_tool xcodebuild "$@" 2>&1 | tee "$temp_output"
        local result=${PIPESTATUS[0]}
        set -e
    else
        set +e
        run_xcode_tool xcodebuild "$@" > "$temp_output" 2>&1
        local result=$?
        set -e
    fi

    if [ $result -ne 0 ]; then
        # Parse and show errors
        local errors
        errors=$(grep -E "^[^:]+:[0-9]+:[0-9]+: error:" "$temp_output" | head -20)
        local generic_errors
        generic_errors=$(grep -E "(error:|ERROR:)" "$temp_output" | grep -v "^[^:]*:[0-9]*:[0-9]*:" | head -10)

        if [ -n "$errors" ]; then
            echo ""
            echo -e "${RED}Build errors:${NC}"
            while IFS= read -r line; do
                [ -z "$line" ] && continue
                local file
                file=$(echo "$line" | sed 's/:.*$//' | xargs basename 2>/dev/null || echo "$line")
                local linenum
                linenum=$(echo "$line" | cut -d: -f2)
                local message
                message=$(echo "$line" | sed 's/^[^:]*:[^:]*:[^:]*: error: *//')
                echo -e "  ${RED}✗${NC} $file:$linenum — $message"
            done <<< "$errors"
        elif [ -n "$generic_errors" ]; then
            echo ""
            echo -e "${RED}Errors:${NC}"
            echo "$generic_errors" | head -10 | while IFS= read -r line; do
                echo -e "  ${RED}✗${NC} $line"
            done
        fi

        # Check for common issues
        if grep -q "No such module" "$temp_output"; then
            log_warn "Missing module — check SPM dependencies"
        fi
        if grep -q "Command PhaseScriptExecution failed" "$temp_output"; then
            log_warn "Build script phase failed"
        fi

        rm -f "$temp_output"
        return $result
    fi

    # Show warnings even on success
    local warnings
    warnings=$(grep -E "^[^:]+:[0-9]+:[0-9]+: warning:" "$temp_output" | head -10)
    if [ -n "$warnings" ]; then
        local wcount
        wcount=$(echo "$warnings" | wc -l | tr -d ' ')
        log_warn "$label completed with $wcount warning(s)"
    fi

    rm -f "$temp_output"
    return 0
}

run_asc() {
    local label="$1"
    shift
    local temp_output
    temp_output=$(mktemp)

    if [ "$VERBOSE" = true ]; then
        set +e
        asc "$@" 2>&1 | tee "$temp_output"
        local result=${PIPESTATUS[0]}
        set -e
    else
        set +e
        asc "$@" > "$temp_output" 2>&1
        local result=$?
        set -e
    fi

    if [ $result -ne 0 ]; then
        echo ""
        echo -e "${RED}${label} failed:${NC}"
        head -20 "$temp_output" | while IFS= read -r line; do
            [ -z "$line" ] && continue
            echo -e "  ${RED}✗${NC} $line"
        done
        rm -f "$temp_output"
        return $result
    fi

    rm -f "$temp_output"
    return 0
}

detect_scheme() {
    # Uses global PROJECT_ARG_ARRAY
    # All log output goes to stderr so stdout is clean for the return value
    log_info "Detecting scheme..." >&2
    local list_output
    list_output=$(run_xcode_tool xcodebuild "${PROJECT_ARG_ARRAY[@]}" -list 2>&1)

    local all_schemes
    all_schemes=$(echo "$list_output" | awk '/Schemes:/{flag=1;next}/^$/{flag=0}flag && !/^[[:space:]]*$/{gsub(/^[[:space:]]+/, "", $0); print $0}')

    if [ -z "$all_schemes" ]; then
        all_schemes=$(echo "$list_output" | sed -n '/Schemes:/,/^$/p' | grep -v "Schemes:" | grep -v "^$" | sed 's/^[[:space:]]*//')
    fi

    local scheme
    scheme=$(echo "$all_schemes" | grep -v -E "(AppIntents?|Widget|Extension|Tests?|UI|Notification|LiveActivity)" | head -1)

    if [ -z "$scheme" ]; then
        scheme=$(echo "$all_schemes" | head -1)
    fi

    if [ -z "$scheme" ]; then
        log_fail "No schemes found" >&2
        echo "Available output:" >&2
        echo "$list_output" >&2
        return 1
    fi

    echo "$scheme"
}

xml_escape() {
    printf '%s' "$1" \
        | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g; s/'"'"'/\&apos;/g'
}

profile_name_for_bundle_id() {
    echo "xc-ci AppStore $1"
}

archive_bundle_ids() {
    local archive_path="$1"
    local app_path
    app_path=$(find "$archive_path/Products/Applications" -maxdepth 1 -name '*.app' -type d -print -quit)

    if [ -z "$app_path" ]; then
        return 1
    fi

    plutil -extract CFBundleIdentifier raw -o - "$app_path/Info.plist"

    local extension_dir
    for extension_dir in "$app_path/PlugIns" "$app_path/Extensions"; do
        [ -d "$extension_dir" ] || continue
        find "$extension_dir" -maxdepth 2 -name Info.plist -path '*.appex/Info.plist' -print 2>/dev/null \
            | while IFS= read -r plist; do
                plutil -extract CFBundleIdentifier raw -o - "$plist"
            done
    done
}

ensure_distribution_identity() {
    if security find-identity -v -p codesigning 2>/dev/null \
        | grep -Eq '"(Apple|iOS|iPhone) Distribution:'; then
        return 0
    fi

    log_fail "No valid Apple/iOS/iPhone Distribution signing identity found in the keychain"
    log_info "Run the one-time signing setup, then retry xc-ci."
    return 1
}

find_installed_profile() {
    local bundle_id="$1"
    local expected_name
    expected_name=$(profile_name_for_bundle_id "$bundle_id")
    local profile_dir="$HOME/Library/MobileDevice/Provisioning Profiles"

    [ -d "$profile_dir" ] || return 1

    find "$profile_dir" -name '*.mobileprovision' -print 2>/dev/null \
        | while IFS= read -r profile; do
            local decoded
            decoded=$(mktemp)
            if security cms -D -i "$profile" > "$decoded" 2>/dev/null; then
                local name app_identifier
                name=$(plutil -extract Name raw -o - "$decoded" 2>/dev/null || true)
                app_identifier=$(plutil -extract Entitlements.application-identifier raw -o - "$decoded" 2>/dev/null || true)
                if [ "$name" = "$expected_name" ] && [[ "$app_identifier" = *".$bundle_id" ]]; then
                    rm -f "$decoded"
                    echo "$profile"
                    return 0
                fi
            fi
            rm -f "$decoded"
        done
}

ensure_profiles_for_archive() {
    local archive_path="$1"
    local missing=false
    local bundle_ids
    bundle_ids=$(archive_bundle_ids "$archive_path") || {
        log_fail "Could not read bundle IDs from archive: $archive_path"
        return 1
    }

    while IFS= read -r bundle_id; do
        [ -z "$bundle_id" ] && continue
        if [ -z "$(find_installed_profile "$bundle_id")" ]; then
            log_fail "Missing installed App Store provisioning profile: $(profile_name_for_bundle_id "$bundle_id")"
            missing=true
        fi
    done <<< "$bundle_ids"

    if [ "$missing" = true ]; then
        log_info "Run the one-time signing setup, then retry xc-ci."
        return 1
    fi

    return 0
}

generate_export_plist() {
    local plist_path="$1"
    local archive_path="$2"
    local team_id
    local bundle_ids

    team_id=$(plutil -extract ApplicationProperties.Team raw -o - "$archive_path/Info.plist")
    bundle_ids=$(archive_bundle_ids "$archive_path")

    {
        cat << PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>export</string>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
    <key>signingStyle</key>
    <string>manual</string>
    <key>teamID</key>
    <string>$(xml_escape "$team_id")</string>
    <key>provisioningProfiles</key>
    <dict>
PLIST
        while IFS= read -r bundle_id; do
            [ -z "$bundle_id" ] && continue
            echo "        <key>$(xml_escape "$bundle_id")</key>"
            echo "        <string>$(xml_escape "$(profile_name_for_bundle_id "$bundle_id")")</string>"
        done <<< "$bundle_ids"
        cat << 'PLIST'
    </dict>
</dict>
</plist>
PLIST
    } > "$plist_path"
}

generate_macos_export_plist() {
    local plist_path="$1"

    cat > "$plist_path" << PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
    <key>teamID</key>
    <string>$(xml_escape "$TEAM_ID")</string>
</dict>
</plist>
PLIST
}

# ─── Argument parsing ────────────────────────────────────────────────────────

while [[ $# -gt 0 ]]; do
    case $1 in
        --repo)
            REPO_URL="$2"; shift 2 ;;
        --repo=*)
            REPO_URL="${1#*=}"; shift ;;
        --branch)
            BRANCH="$2"; shift 2 ;;
        --branch=*)
            BRANCH="${1#*=}"; shift ;;
        --scheme)
            SCHEME="$2"; shift 2 ;;
        --scheme=*)
            SCHEME="${1#*=}"; shift ;;
        --xcode-dir)
            if [ $# -lt 2 ] || [[ "$2" == --* ]]; then
                echo -e "${RED}Error: --xcode-dir requires a path${NC}"
                exit 1
            fi
            XCODE_DIR_PROVIDED=true
            XCODE_DIR="$2"; shift 2 ;;
        --xcode-dir=*)
            XCODE_DIR_PROVIDED=true
            XCODE_DIR="${1#*=}"; shift ;;
        --team-id)
            if [ $# -lt 2 ] || [[ "$2" == --* ]]; then
                echo -e "${RED}Error: --team-id requires an ID${NC}"
                exit 1
            fi
            TEAM_ID="$2"; shift 2 ;;
        --team-id=*)
            TEAM_ID="${1#*=}"; shift ;;
        --app-id)
            APP_ID="$2"; shift 2 ;;
        --app-id=*)
            APP_ID="${1#*=}"; shift ;;
        --skip-tests)
            SKIP_TESTS=true; shift ;;
        --ios-only)
            IOS_ONLY=true; shift ;;
        --visionos-only)
            VISIONOS_ONLY=true; shift ;;
        --macos-only)
            MACOS_ONLY=true; shift ;;
        --keep-workspace)
            KEEP_WORKSPACE=true; shift ;;
        --verbose)
            VERBOSE=true; shift ;;
        -h|--help)
            show_help; exit 0 ;;
        *)
            echo "Unknown option: $1"
            show_help; exit 1 ;;
    esac
done

if [ -z "$REPO_URL" ]; then
    echo -e "${RED}Error: --repo is required${NC}"
    echo ""
    show_help
    exit 1
fi

if [ -z "$APP_ID" ]; then
    echo -e "${RED}Error: --app-id is required${NC}"
    echo ""
    show_help
    exit 1
fi

PLATFORM_ONLY_COUNT=0
if [ "$IOS_ONLY" = true ]; then PLATFORM_ONLY_COUNT=$((PLATFORM_ONLY_COUNT + 1)); fi
if [ "$VISIONOS_ONLY" = true ]; then PLATFORM_ONLY_COUNT=$((PLATFORM_ONLY_COUNT + 1)); fi
if [ "$MACOS_ONLY" = true ]; then PLATFORM_ONLY_COUNT=$((PLATFORM_ONLY_COUNT + 1)); fi
if [ "$PLATFORM_ONLY_COUNT" -gt 1 ]; then
    echo -e "${RED}Specify only one of --ios-only, --visionos-only, or --macos-only${NC}"
    exit 1
fi

if [ "$MACOS_ONLY" = true ] && [ -z "$TEAM_ID" ]; then
    echo -e "${RED}Error: --team-id is required with --macos-only${NC}"
    exit 1
fi

if ! validate_xcode_dir; then
    exit 1
fi

# ─── Trap for cleanup ────────────────────────────────────────────────────────

trap cleanup EXIT

# ─── Preflight ───────────────────────────────────────────────────────────────

log_xcode_selection

log_info "Verifying App Store Connect authentication with asc..."
if run_asc "asc auth doctor" auth doctor; then
    log_ok "asc authentication verified"
else
    log_fail "asc authentication failed"
    exit 1
fi

if ensure_distribution_identity; then
    log_ok "Distribution signing identity found"
else
    exit 1
fi

# ─── Step 1: Clone ───────────────────────────────────────────────────────────

log_step "Step 1/7: Clone into isolated workspace"

WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp/}xc-ci-XXXXXXXX")
DERIVED_DATA="$WORK_DIR/DerivedData"
mkdir -p "$DERIVED_DATA"

log_info "Workspace: $WORK_DIR"
log_info "Cloning $BRANCH from $REPO_URL..."

git clone --branch "$BRANCH" --depth 1 "$REPO_URL" "$WORK_DIR/repo"
cd "$WORK_DIR/repo"

log_ok "Cloned $(git log -1 --format='%h %s')"

# Detect project/workspace — use array to handle spaces in names
PROJECT_ARG_ARRAY=()
if ls *.xcworkspace 1>/dev/null 2>&1; then
    WORKSPACE=$(ls -d *.xcworkspace | head -1)
    PROJECT_ARG_ARRAY=(-workspace "$WORKSPACE")
    log_info "Using workspace: $WORKSPACE"
elif ls *.xcodeproj 1>/dev/null 2>&1; then
    PROJECT=$(ls -d *.xcodeproj | head -1)
    PROJECT_ARG_ARRAY=(-project "$PROJECT")
    log_info "Using project: $PROJECT"
else
    log_fail "No Xcode project or workspace found"
    exit 1
fi

# Detect scheme
if [ -z "$SCHEME" ]; then
    SCHEME=$(detect_scheme)
fi
log_ok "Scheme: $SCHEME"

# ─── Step 2: Resolve dependencies ────────────────────────────────────────────

step_timer_start
log_step "Step 2/7: Resolve SPM dependencies"

if run_xcodebuild "SPM resolve" \
    "${PROJECT_ARG_ARRAY[@]}" \
    -scheme "$SCHEME" \
    -resolvePackageDependencies \
    -derivedDataPath "$DERIVED_DATA"; then
    log_ok "Dependencies resolved"
    record_step "Resolve dependencies" "PASS"
else
    log_fail "Failed to resolve dependencies"
    record_step "Resolve dependencies" "FAIL"
    print_summary
    exit 1
fi

# ─── Compute build number ──────────────────────────────────────────────────

DO_IOS=true
DO_VISIONOS=true
DO_MACOS=false
if [ "$IOS_ONLY" = true ]; then DO_VISIONOS=false; fi
if [ "$VISIONOS_ONLY" = true ]; then DO_IOS=false; fi
if [ "$MACOS_ONLY" = true ]; then
    DO_IOS=false
    DO_VISIONOS=false
    DO_MACOS=true
fi

if [ "$DO_MACOS" = true ]; then
    log_info "Querying MARKETING_VERSION from scheme $SCHEME..."
    BUILD_SETTINGS_ERROR=$(mktemp)
    set +e
    BUILD_SETTINGS_JSON=$(run_xcode_tool xcodebuild \
        "${PROJECT_ARG_ARRAY[@]}" \
        -scheme "$SCHEME" \
        -configuration Release \
        -destination "generic/platform=macOS" \
        -showBuildSettings \
        -json 2>"$BUILD_SETTINGS_ERROR")
    BUILD_SETTINGS_RESULT=$?
    set -e
    if [ "$BUILD_SETTINGS_RESULT" -ne 0 ]; then
        log_fail "Failed to query MARKETING_VERSION from scheme $SCHEME"
        head -20 "$BUILD_SETTINGS_ERROR" | while IFS= read -r line; do
            [ -z "$line" ] && continue
            echo -e "  ${RED}✗${NC} $line"
        done
        rm -f "$BUILD_SETTINGS_ERROR"
        print_summary
        exit 1
    fi
    rm -f "$BUILD_SETTINGS_ERROR"

    MARKETING_VERSION=$(echo "$BUILD_SETTINGS_JSON" | jq -r '
        ([.[] | select(.buildSettings.PRODUCT_TYPE == "com.apple.product-type.application") | .buildSettings.MARKETING_VERSION]
        + [.[] | .buildSettings.MARKETING_VERSION])
        | map(select(. != null and . != ""))
        | first // empty
    ' 2>/dev/null)
    if [ -z "$MARKETING_VERSION" ]; then
        log_fail "Scheme $SCHEME does not expose a MARKETING_VERSION for macOS"
        print_summary
        exit 1
    fi
    log_ok "Marketing version: $MARKETING_VERSION"

    MACOS_BUNDLE_ID=$(echo "$BUILD_SETTINGS_JSON" | jq -r '
        ([.[] | select(.buildSettings.PRODUCT_TYPE == "com.apple.product-type.application") | .buildSettings.PRODUCT_BUNDLE_IDENTIFIER]
        + [.[] | .buildSettings.PRODUCT_BUNDLE_IDENTIFIER])
        | map(select(. != null and . != ""))
        | first // empty
    ' 2>/dev/null)
    if [ -n "$MACOS_BUNDLE_ID" ]; then
        log_ok "Bundle ID: $MACOS_BUNDLE_ID"
    fi

    log_info "Querying next macOS build number from App Store Connect..."
    set +e
    NEXT_BUILD_OUTPUT=$(asc builds next-build-number \
        --app "$APP_ID" \
        --version "$MARKETING_VERSION" \
        --platform MAC_OS \
        --output json 2>&1)
    NEXT_BUILD_RESULT=$?
    set -e
    if [ "$NEXT_BUILD_RESULT" -ne 0 ]; then
        log_fail "Failed to query the next macOS build number with asc"
        echo "$NEXT_BUILD_OUTPUT" | head -20 | while IFS= read -r line; do
            [ -z "$line" ] && continue
            echo -e "  ${RED}✗${NC} $line"
        done
        print_summary
        exit 1
    fi
    if [ "$VERBOSE" = true ]; then
        echo "$NEXT_BUILD_OUTPUT"
    fi

    BUILD_NUMBER=$(echo "$NEXT_BUILD_OUTPUT" | jq -r '
        if type == "number" or type == "string" then .
        else .nextBuildNumber // .data.nextBuildNumber // .data.attributes.nextBuildNumber // empty
        end
    ' 2>/dev/null)
    if ! [[ "$BUILD_NUMBER" =~ ^[0-9]+$ ]]; then
        log_fail "asc returned an invalid next macOS build number"
        log_info "Output: $NEXT_BUILD_OUTPUT"
        print_summary
        exit 1
    fi
    log_ok "Build number: $BUILD_NUMBER"
else
log_info "Querying App Store Connect for latest build number..."
set +e
BUILDS_JSON=$(asc builds list --app "$APP_ID" --sort=-uploadedDate --limit 20 --output json 2>/dev/null)
BUILDS_RESULT=$?
set -e
if [ "$BUILDS_RESULT" -ne 0 ]; then
    log_fail "Failed to query App Store Connect builds with asc"
    print_summary
    exit 1
fi
LATEST_BUILD=$(echo "$BUILDS_JSON" | jq -r '[.data[].attributes.version | tonumber] | max // 0' 2>/dev/null || echo "0")
LATEST_BUILD=${LATEST_BUILD:-0}
BUILD_NUMBER=$((LATEST_BUILD + 1))
log_ok "Build number: $BUILD_NUMBER (previous: $LATEST_BUILD)"
fi

# ─── Step 3: Test iOS ────────────────────────────────────────────────────────

if [ "$DO_MACOS" = true ] && [ "$SKIP_TESTS" = false ]; then
    step_timer_start
    log_step "Step 3/7: Test macOS"

    MACOS_RESULT_BUNDLE="$WORK_DIR/macos-test-results.xcresult"
    if run_xcodebuild "macOS tests" \
        "${PROJECT_ARG_ARRAY[@]}" \
        -scheme "$SCHEME" \
        -destination "platform=macOS" \
        -derivedDataPath "$DERIVED_DATA" \
        -resultBundlePath "$MACOS_RESULT_BUNDLE" \
        -configuration Debug \
        test; then
        log_ok "macOS tests passed"
        record_step "Test macOS" "PASS"
    else
        log_fail "macOS tests failed"
        record_step "Test macOS" "FAIL"
        print_summary
        exit 1
    fi
elif [ "$DO_MACOS" = true ]; then
    log_info "Skipping macOS tests (--skip-tests)"
    record_step "Test macOS" "SKIP"
elif [ "$DO_IOS" = true ] && [ "$SKIP_TESTS" = false ]; then
    step_timer_start
    log_step "Step 3/7: Test iOS"

    # Keep the simulator runtime aligned with the selected Xcode SDK. Newer beta
    # runtimes may be visible to stable Xcode but are not a valid CI pairing.
    IOS_SDK_VERSION=$(run_xcode_tool xcrun --sdk iphonesimulator --show-sdk-version 2>/dev/null)
    if [ -z "$IOS_SDK_VERSION" ]; then
        log_fail "Could not determine the selected Xcode iOS Simulator SDK version"
        record_step "Test iOS" "FAIL"
        print_summary
        exit 1
    fi
    IOS_RUNTIME_ID="com.apple.CoreSimulator.SimRuntime.iOS-${IOS_SDK_VERSION//./-}"

    IOS_RUNTIME_AVAILABLE=$(run_xcode_tool xcrun simctl list runtimes available -j 2>/dev/null \
        | jq -r --arg runtime "$IOS_RUNTIME_ID" \
            '[.runtimes[]? | select(.identifier == $runtime and .isAvailable == true)] | length > 0' \
            2>/dev/null || true)
    if [ "$IOS_RUNTIME_AVAILABLE" != "true" ]; then
        log_fail "The selected Xcode does not expose an available iOS $IOS_SDK_VERSION simulator runtime ($IOS_RUNTIME_ID)"
        record_step "Test iOS" "FAIL"
        print_summary
        exit 1
    fi

    # Prefer Pro Max, then Pro, then any iPhone device type.
    IOS_DEVICE_TYPE=$(run_xcode_tool xcrun simctl list devicetypes -j 2>/dev/null \
        | jq -r --arg sdk "$IOS_SDK_VERSION" '
            ($sdk | split(".") | map(tonumber) + [0, 0, 0]) as $version
            | (($version[0] * 65536) + ($version[1] * 256) + $version[2]) as $runtime_version
            | [.devicetypes[]?
                | select(.productFamily == "iPhone" or (.name | test("^iPhone")))
                | select((.minRuntimeVersion // 0) <= $runtime_version)
                | select((.maxRuntimeVersion // 4294967295) >= $runtime_version)]
            | ((map(select(.name | test("Pro Max"))) | first)
              // (map(select(.name | test("Pro"))) | first)
              // first)
            | select(. != null)
            | [.name, .identifier]
            | @tsv
        ' 2>/dev/null || true)
    IFS=$'\t' read -r IOS_DEVICE_TYPE_NAME IOS_DEVICE_TYPE_ID <<< "$IOS_DEVICE_TYPE"
    if [ -z "$IOS_DEVICE_TYPE_ID" ]; then
        log_fail "No iPhone simulator device type is available in the selected Xcode"
        record_step "Test iOS" "FAIL"
        print_summary
        exit 1
    fi

    IOS_SIMULATOR_NAME="xc-ci-iOS-$$-$(date +%s)-$RANDOM"
    IOS_SIMULATOR_CREATE_OUTPUT=$(mktemp)
    IOS_SIMULATOR_CREATE_ERROR=$(mktemp)
    set +e
    run_xcode_tool xcrun simctl create \
        "$IOS_SIMULATOR_NAME" \
        "$IOS_DEVICE_TYPE_ID" \
        "$IOS_RUNTIME_ID" >"$IOS_SIMULATOR_CREATE_OUTPUT" 2>"$IOS_SIMULATOR_CREATE_ERROR" &
    IOS_SIMULATOR_CREATE_PID=$!
    wait "$IOS_SIMULATOR_CREATE_PID"
    IOS_SIMULATOR_CREATE_RESULT=$?
    IOS_SIMULATOR_CREATE_PID=""
    set -e
    CREATED_IOS_SIMULATOR_ID=$(tr -d '[:space:]' < "$IOS_SIMULATOR_CREATE_OUTPUT")

    if [ "$IOS_SIMULATOR_CREATE_RESULT" -ne 0 ]; then
        log_fail "Could not create a temporary iOS $IOS_SDK_VERSION simulator"
        head -10 "$IOS_SIMULATOR_CREATE_ERROR" | while IFS= read -r line; do
            [ -z "$line" ] && continue
            echo -e "  ${RED}✗${NC} $line"
        done
        rm -f "$IOS_SIMULATOR_CREATE_OUTPUT" "$IOS_SIMULATOR_CREATE_ERROR"
        IOS_SIMULATOR_CREATE_OUTPUT=""
        IOS_SIMULATOR_CREATE_ERROR=""
        record_step "Test iOS" "FAIL"
        print_summary
        exit 1
    fi

    # A successful simctl create owns its valid returned UDID. Retain it for
    # cleanup even if the following unique-name lookup is temporarily empty.
    if [[ "$CREATED_IOS_SIMULATOR_ID" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]]; then
        IOS_TEST_SIMULATOR_ID="$CREATED_IOS_SIMULATOR_ID"
    fi
    rm -f "$IOS_SIMULATOR_CREATE_OUTPUT" "$IOS_SIMULATOR_CREATE_ERROR"
    IOS_SIMULATOR_CREATE_OUTPUT=""
    IOS_SIMULATOR_CREATE_ERROR=""

    DISCOVERED_IOS_SIMULATOR_ID=$(run_xcode_tool xcrun simctl list devices -j 2>/dev/null \
        | jq -r --arg runtime "$IOS_RUNTIME_ID" --arg name "$IOS_SIMULATOR_NAME" '
            [.devices[$runtime][]? | select(.name == $name)]
            | if length == 1 then .[0].udid else empty end
        ' 2>/dev/null || true)

    if ! [[ "$CREATED_IOS_SIMULATOR_ID" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]]; then
        if [[ "$DISCOVERED_IOS_SIMULATOR_ID" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]]; then
            IOS_TEST_SIMULATOR_ID="$DISCOVERED_IOS_SIMULATOR_ID"
        fi
        log_fail "simctl create returned an invalid simulator UDID: ${CREATED_IOS_SIMULATOR_ID:-<empty>}"
        record_step "Test iOS" "FAIL"
        print_summary
        exit 1
    fi
    if [ "$DISCOVERED_IOS_SIMULATOR_ID" != "$CREATED_IOS_SIMULATOR_ID" ]; then
        log_fail "Could not validate the newly created iOS simulator on $IOS_RUNTIME_ID"
        log_info "simctl create returned $CREATED_IOS_SIMULATOR_ID; the unique-name lookup found ${DISCOVERED_IOS_SIMULATOR_ID:-no device}"
        record_step "Test iOS" "FAIL"
        print_summary
        exit 1
    fi
    IOS_TEST_SIMULATOR_ID="$CREATED_IOS_SIMULATOR_ID"
    log_info "Created temporary simulator: $IOS_SIMULATOR_NAME ($IOS_DEVICE_TYPE_NAME), iOS $IOS_SDK_VERSION ($IOS_TEST_SIMULATOR_ID)"

    RESULT_BUNDLE="$WORK_DIR/test_results.xcresult"

    if run_xcodebuild "iOS tests" \
        "${PROJECT_ARG_ARRAY[@]}" \
        -scheme "$SCHEME" \
        -destination "platform=iOS Simulator,id=$IOS_TEST_SIMULATOR_ID" \
        -derivedDataPath "$DERIVED_DATA" \
        -resultBundlePath "$RESULT_BUNDLE" \
        -configuration Debug \
        test; then

        # Parse test results
        if [ -d "$RESULT_BUNDLE" ]; then
            TEST_JSON=$(run_xcode_tool xcrun xcresulttool get test-results summary --path "$RESULT_BUNDLE" --format json 2>/dev/null || echo "{}")
            if command -v jq >/dev/null 2>&1; then
                PASSED=$(echo "$TEST_JSON" | jq -r '[.devicesAndConfigurations[]?.passedTests // 0] | add' 2>/dev/null || echo "0")
                FAILED=$(echo "$TEST_JSON" | jq -r '[.devicesAndConfigurations[]?.failedTests // 0] | add' 2>/dev/null || echo "0")
            else
                PASSED=$(echo "$TEST_JSON" | grep -o '"passedTests"[[:space:]]*:[[:space:]]*[0-9]*' | grep -o '[0-9]*$' | head -1 || echo "0")
                FAILED=$(echo "$TEST_JSON" | grep -o '"failedTests"[[:space:]]*:[[:space:]]*[0-9]*' | grep -o '[0-9]*$' | head -1 || echo "0")
            fi
            PASSED=${PASSED:-0}
            FAILED=${FAILED:-0}
            log_ok "Tests passed: $PASSED passed, $FAILED failed"
        else
            log_ok "Tests passed"
        fi
        if ! cleanup_ios_test_simulator; then
            log_info "Retrying temporary simulator cleanup..."
            if ! cleanup_ios_test_simulator; then
                log_fail "iOS tests passed, but temporary simulator cleanup failed"
                record_step "Test iOS" "FAIL"
                print_summary
                exit 1
            fi
        fi
        record_step "Test iOS" "PASS"
    else
        cleanup_ios_test_simulator || true
        log_fail "iOS tests failed"
        record_step "Test iOS" "FAIL"
        print_summary
        exit 1
    fi
elif [ "$DO_IOS" = true ]; then
    log_info "Skipping iOS tests (--skip-tests)"
    record_step "Test iOS" "SKIP"
else
    record_step "Test iOS" "SKIP"
fi

# ─── Step 4: Build-check visionOS ────────────────────────────────────────────

if [ "$DO_VISIONOS" = true ]; then
    step_timer_start
    log_step "Step 4/7: Build-check visionOS"

    if run_xcodebuild "visionOS build" \
        "${PROJECT_ARG_ARRAY[@]}" \
        -scheme "$SCHEME" \
        -destination "generic/platform=visionOS Simulator" \
        -derivedDataPath "$DERIVED_DATA" \
        -configuration Debug \
        build; then
        log_ok "visionOS compilation check passed"
        record_step "Build-check visionOS" "PASS"
    else
        log_fail "visionOS does not compile"
        record_step "Build-check visionOS" "FAIL"
        print_summary
        exit 2
    fi
else
    record_step "Build-check visionOS" "SKIP"
fi

# ─── Step 5: Archive iOS ─────────────────────────────────────────────────────

if [ "$DO_IOS" = true ]; then
    step_timer_start
    log_step "Step 5/7: Archive + upload iOS"

    IOS_ARCHIVE="$WORK_DIR/ios.xcarchive"

    log_info "Archiving (build $BUILD_NUMBER)..."
    if run_xcodebuild "iOS archive" \
        "${PROJECT_ARG_ARRAY[@]}" \
        -scheme "$SCHEME" \
        -destination "generic/platform=iOS" \
        -derivedDataPath "$DERIVED_DATA" \
        -archivePath "$IOS_ARCHIVE" \
        -configuration Release \
        CURRENT_PROJECT_VERSION="$BUILD_NUMBER" \
        archive; then
        log_ok "iOS archive created"
    else
        log_fail "iOS archive failed"
        record_step "Archive + upload iOS" "FAIL"
        print_summary
        exit 3
    fi

    IOS_EXPORT_DIR="$WORK_DIR/ios-export"
    IOS_EXPORT_PLIST="$WORK_DIR/ios-ExportOptions.plist"

    if ensure_profiles_for_archive "$IOS_ARCHIVE"; then
        generate_export_plist "$IOS_EXPORT_PLIST" "$IOS_ARCHIVE"
    else
        record_step "Archive + upload iOS" "FAIL"
        print_summary
        exit 3
    fi

    log_info "Exporting IPA..."
    if run_xcodebuild "iOS export" \
        -exportArchive \
        -archivePath "$IOS_ARCHIVE" \
        -exportPath "$IOS_EXPORT_DIR" \
        -exportOptionsPlist "$IOS_EXPORT_PLIST"; then
        IOS_IPA=$(find "$IOS_EXPORT_DIR" -maxdepth 1 -name '*.ipa' -print -quit)
        if [ -z "$IOS_IPA" ]; then
            log_fail "iOS export did not produce an IPA"
            record_step "Archive + upload iOS" "FAIL"
            print_summary
            exit 3
        fi
        log_ok "iOS IPA exported: $(basename "$IOS_IPA")"
    else
        log_fail "iOS export failed"
        record_step "Archive + upload iOS" "FAIL"
        print_summary
        exit 3
    fi

    log_info "Uploading IPA to App Store Connect with asc..."
    if run_asc "iOS upload" builds upload \
        --app "$APP_ID" \
        --platform IOS \
        --ipa "$IOS_IPA" \
        --wait \
        --poll-interval 15s; then
        log_ok "iOS build uploaded to App Store Connect"
        record_step "Archive + upload iOS" "PASS"
    else
        log_fail "iOS upload failed"
        record_step "Archive + upload iOS" "FAIL"
        print_summary
        exit 3
    fi
else
    record_step "Archive + upload iOS" "SKIP"
fi

# ─── Step 6: Archive visionOS ────────────────────────────────────────────────

if [ "$DO_VISIONOS" = true ]; then
    step_timer_start
    log_step "Step 6/7: Archive + upload visionOS"

    VISIONOS_ARCHIVE="$WORK_DIR/visionos.xcarchive"

    log_info "Archiving (build $BUILD_NUMBER)..."
    if run_xcodebuild "visionOS archive" \
        "${PROJECT_ARG_ARRAY[@]}" \
        -scheme "$SCHEME" \
        -destination "generic/platform=visionOS" \
        -derivedDataPath "$DERIVED_DATA" \
        -archivePath "$VISIONOS_ARCHIVE" \
        -configuration Release \
        CURRENT_PROJECT_VERSION="$BUILD_NUMBER" \
        archive; then
        log_ok "visionOS archive created"
    else
        log_fail "visionOS archive failed"
        record_step "Archive + upload visionOS" "FAIL"
        print_summary
        exit 3
    fi

    VISIONOS_EXPORT_DIR="$WORK_DIR/visionos-export"
    VISIONOS_EXPORT_PLIST="$WORK_DIR/visionos-ExportOptions.plist"

    if ensure_profiles_for_archive "$VISIONOS_ARCHIVE"; then
        generate_export_plist "$VISIONOS_EXPORT_PLIST" "$VISIONOS_ARCHIVE"
    else
        record_step "Archive + upload visionOS" "FAIL"
        print_summary
        exit 3
    fi

    log_info "Exporting IPA..."
    if run_xcodebuild "visionOS export" \
        -exportArchive \
        -archivePath "$VISIONOS_ARCHIVE" \
        -exportPath "$VISIONOS_EXPORT_DIR" \
        -exportOptionsPlist "$VISIONOS_EXPORT_PLIST"; then
        VISIONOS_IPA=$(find "$VISIONOS_EXPORT_DIR" -maxdepth 1 -name '*.ipa' -print -quit)
        if [ -z "$VISIONOS_IPA" ]; then
            log_fail "visionOS export did not produce an IPA"
            record_step "Archive + upload visionOS" "FAIL"
            print_summary
            exit 3
        fi
        log_ok "visionOS IPA exported: $(basename "$VISIONOS_IPA")"
    else
        log_fail "visionOS export failed"
        record_step "Archive + upload visionOS" "FAIL"
        print_summary
        exit 3
    fi

    log_info "Uploading IPA to App Store Connect with asc..."
    if run_asc "visionOS upload" builds upload \
        --app "$APP_ID" \
        --platform VISION_OS \
        --ipa "$VISIONOS_IPA" \
        --wait \
        --poll-interval 15s; then
        log_ok "visionOS build uploaded to App Store Connect"
        record_step "Archive + upload visionOS" "PASS"
    else
        log_fail "visionOS upload failed"
        record_step "Archive + upload visionOS" "FAIL"
        print_summary
        exit 3
    fi
else
    record_step "Archive + upload visionOS" "SKIP"
fi

# ─── Done ─────────────────────────────────────────────────────────────────────

if [ "$DO_MACOS" = true ]; then
    step_timer_start
    log_step "Step 7/7: Archive + upload macOS"

    MACOS_ARCHIVE="$WORK_DIR/macos.xcarchive"
    MACOS_EXPORT_DIR="$WORK_DIR/macos-export"
    MACOS_EXPORT_PLIST="$WORK_DIR/macos-ExportOptions.plist"

    log_info "Archiving macOS $MARKETING_VERSION (build $BUILD_NUMBER)..."
    if run_xcodebuild "macOS archive" \
        "${PROJECT_ARG_ARRAY[@]}" \
        -scheme "$SCHEME" \
        -configuration Release \
        -destination "generic/platform=macOS" \
        -derivedDataPath "$DERIVED_DATA" \
        -archivePath "$MACOS_ARCHIVE" \
        CURRENT_PROJECT_VERSION="$BUILD_NUMBER" \
        DEVELOPMENT_TEAM="$TEAM_ID" \
        -allowProvisioningUpdates \
        clean archive; then
        log_ok "macOS archive created"
    else
        log_fail "macOS archive failed"
        record_step "Archive + upload macOS" "FAIL"
        print_summary
        exit 3
    fi

    MACOS_APP=$(find "$MACOS_ARCHIVE/Products/Applications" -maxdepth 1 -type d -name '*.app' -print -quit)
    if [ -z "$MACOS_APP" ]; then
        log_fail "macOS archive does not contain an application"
        record_step "Archive + upload macOS" "FAIL"
        print_summary
        exit 3
    fi

    MACOS_APP_CATEGORY=$(plutil -extract LSApplicationCategoryType raw -o - "$MACOS_APP/Contents/Info.plist" 2>/dev/null || true)
    if [ -z "$MACOS_APP_CATEGORY" ]; then
        log_fail "macOS app is missing LSApplicationCategoryType"
        log_info "Set the target's App Category before uploading to the Mac App Store."
        record_step "Archive + upload macOS" "FAIL"
        print_summary
        exit 3
    fi
    log_ok "App category: $MACOS_APP_CATEGORY"

    generate_macos_export_plist "$MACOS_EXPORT_PLIST"

    log_info "Exporting macOS installer package..."
    if run_xcodebuild "macOS export" \
        -exportArchive \
        -archivePath "$MACOS_ARCHIVE" \
        -exportPath "$MACOS_EXPORT_DIR" \
        -exportOptionsPlist "$MACOS_EXPORT_PLIST" \
        -allowProvisioningUpdates; then
        MACOS_PKG=$(find "$MACOS_EXPORT_DIR" -type f -name '*.pkg' -print -quit)
        if [ -z "$MACOS_PKG" ]; then
            log_fail "macOS export did not produce a PKG"
            record_step "Archive + upload macOS" "FAIL"
            print_summary
            exit 3
        fi
        log_ok "macOS PKG exported: $(basename "$MACOS_PKG")"
    else
        log_fail "macOS export failed"
        record_step "Archive + upload macOS" "FAIL"
        print_summary
        exit 3
    fi

    log_info "Uploading PKG to App Store Connect with asc..."
    if run_asc "macOS upload" builds upload \
        --app "$APP_ID" \
        --pkg "$MACOS_PKG" \
        --version "$MARKETING_VERSION" \
        --build-number "$BUILD_NUMBER" \
        --wait; then
        log_ok "macOS build uploaded to App Store Connect"
        record_step "Archive + upload macOS" "PASS"
    else
        log_fail "macOS upload failed"
        record_step "Archive + upload macOS" "FAIL"
        print_summary
        exit 3
    fi
else
    record_step "Archive + upload macOS" "SKIP"
fi

print_summary
echo -e "${GREEN}${BOLD}Pipeline complete!${NC}"
exit 0
